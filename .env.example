# KATMANDU v2 — Environment Variables
# Optional local development settings. Prefer entering API keys in application Settings.
# VITE values reach the browser; production builds reject populated credential variables.

# OpenAI API Key
VITE_OPENAI_API_KEY=

# OpenAI API Base URL (default: https://api.openai.com/v1)
VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# Model ID (GPT-5.6 Terra)
VITE_OPENAI_MODEL=gpt-5.6-terra

# Reasoning Level (low | medium | high)
VITE_OPENAI_REASONING_EFFORT=medium

# DeepSeek API Key
VITE_DEEPSEEK_API_KEY=

# DeepSeek API Base URL (default: https://api.deepseek.com)
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek Model ID (deepseek-reasoner | deepseek-chat)
VITE_DEEPSEEK_MODEL=deepseek-reasoner
